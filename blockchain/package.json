{
  "name": "multibaas-sample-hardhat-project",
  "version": "1.0.0",
  "description": "MultiBaas Sample Hardhat Project",
  "main": "index.js",
  "scripts": {
    "prepare": "cd .. && husky blockchain/.husky",
    "fix:eslint": "eslint --fix '{*,**/*}.{js,ts}'",
    "fix:prettier": "prettier --write --plugin=prettier-plugin-solidity 'contracts/**/*.sol'",
    "fix:solhint": "solhint --fix --noPrompt 'contracts/**/*.sol'",
    "fix:sol": "npm run fix:prettier && npm run fix:solhint",
    "fix:all": "npm run fix:eslint && npm run fix:sol",
    "test": "npx hardhat test",
    "deploy:marketplace:base-sepolia": "HARDHAT_NETWORK=base-sepolia npx hardhat run scripts/deploy-marketplace-v2.ts",
    "deploy:marketplace:base-sepolia:with-products": "ADD_SAMPLE_PRODUCTS=true HARDHAT_NETWORK=base-sepolia npx hardhat run scripts/deploy-marketplace-v2.ts",
    "admin:add": "HARDHAT_NETWORK=base-sepolia npx hardhat run scripts/add-admin.ts",
    "admin:remove": "HARDHAT_NETWORK=base-sepolia npx hardhat run scripts/remove-admin.ts",
    "admin:check": "HARDHAT_NETWORK=base-sepolia npx hardhat run scripts/check-admin.ts",
    "cleanup:addresses": "HARDHAT_NETWORK=base-sepolia npx hardhat run scripts/cleanup-addresses.ts",
    "generate:wallet": "npx ts-node scripts/generate-wallet.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://curvegrid/multibaas-sample-hardhat-project.git"
  },
  "author": "Curvegrid Inc.",
  "license": "MIT",
  "private": true,
  "bugs": {
    "url": "https://github.com/curvegrid/multibaas-sample-hardhat-project/issues"
  },
  "homepage": "https://github.com/curvegrid/multibaas-sample-hardhat-project#readme",
  "lint-staged": {
    "*.{js,ts}": "eslint --fix",
    "*.json": "prettier --write",
    "*.sol": "npm run fix:sol"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "hardhat": "^2.22.18",
    "hardhat-multibaas-plugin": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^1.4.2",
    "solhint": "^5.0.4",
    "typescript-eslint": "^8.20.0"
  }
}
